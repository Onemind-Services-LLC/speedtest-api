SPEEDTEST_ENV=production
REGION_ID=blr
REGION_NAME=Bangalore
PUBLIC_ORIGIN=https://blr.speedtest.onemindservices.cloud
ALLOWED_ORIGINS=https://blr.speedtest.onemindservices.cloud,https://speedtest.onemindservices.cloud
BROWSER_REDIRECT_URL=https://speedtest.onemindservices.cloud/
LISTEN_ADDR=127.0.0.1:8080
METRICS_LISTEN_ADDR=127.0.0.1:9090
TLS_LISTEN_ADDR=0.0.0.0:443
HTTP_REDIRECT_ADDR=0.0.0.0:80
ACME_CHALLENGE_DIR=/var/lib/speedtest-acme/.well-known/acme-challenge
TLS_CERT_FILE=/etc/speedtest/tls/current/tls.crt
TLS_KEY_FILE=/etc/speedtest/tls/current/tls.key
PROXY_PROTOCOL_TRUSTED_CIDRS=
TRUSTED_PROXY_CIDRS=
WEBRTC_LISTEN_ADDR=0.0.0.0:8081
WEBRTC_PUBLIC_IP=VM_PUBLIC_IPV4
ASN_DATABASE_PATH=/var/lib/speedtest/asn.mmdb
MAX_DOWNLOAD_BYTES=67108864
MAX_UPLOAD_BYTES=67108864
MAX_CONCURRENT_TRANSFERS=64
MAX_TRANSFERS_PER_CLIENT=16
MAX_WEBRTC_SESSIONS=64
MAX_WEBRTC_PER_CLIENT=16
REQUEST_TIMEOUT=30s
LOG_LEVEL=info
GOMEMLIMIT=384MiB
