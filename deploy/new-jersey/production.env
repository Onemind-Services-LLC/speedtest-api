SPEEDTEST_ENV=production
REGION_ID=nnj
REGION_NAME=New Jersey
ASN_DATABASE_PATH=/data/asn.mmdb
LISTEN_ADDR=:8080
ALLOWED_ORIGINS=https://nnj.speedtest.onemindservices.cloud,https://speedtest.onemindservices.cloud
MAX_DOWNLOAD_BYTES=67108864
MAX_UPLOAD_BYTES=67108864
MAX_CONCURRENT_TRANSFERS=64
MAX_TRANSFERS_PER_CLIENT=16
REQUEST_TIMEOUT=30s
LOG_LEVEL=info
WEBRTC_LISTEN_ADDR=:8081
# HTTP and UDP Services share the direct API LoadBalancer.
WEBRTC_PUBLIC_IP=38.67.240.85
MAX_WEBRTC_SESSIONS=64
MAX_WEBRTC_PER_CLIENT=16
# Direct listeners use authenticated PROXY protocol, never HTTP forwarding headers.
TRUSTED_PROXY_CIDRS=
GOMEMLIMIT=384MiB

TLS_LISTEN_ADDR=:8443
TLS_CERT_FILE=/tls/tls.crt
TLS_KEY_FILE=/tls/tls.key
PUBLIC_ORIGIN=https://nnj.speedtest.onemindservices.cloud
HTTP_REDIRECT_ADDR=:8082
BROWSER_REDIRECT_URL=https://speedtest.onemindservices.cloud/
PROXY_PROTOCOL_TRUSTED_CIDRS=172.16.3.0/24
