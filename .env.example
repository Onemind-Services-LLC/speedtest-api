# Optional: defaults already work with the UI on http://localhost:3000.
LISTEN_ADDR=:8080
REGION_ID=local
REGION_NAME="Local development"
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_DOWNLOAD_BYTES=67108864
MAX_UPLOAD_BYTES=67108864
MAX_CONCURRENT_TRANSFERS=64
REQUEST_TIMEOUT=30s
# JSON request logs: debug includes health checks and CORS preflights.
LOG_LEVEL=info

# A single UDP port for WebRTC packet-loss tests. Empty disables the feature.
WEBRTC_LISTEN_ADDR=:8081
WEBRTC_PUBLIC_IP=
MAX_WEBRTC_SESSIONS=64

# Optional local ASN database and explicit trusted ingress ranges.
ASN_DATABASE_PATH=
TRUSTED_PROXY_CIDRS=
